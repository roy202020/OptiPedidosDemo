# Secretos de la Edge Function enviar-whatsapp (Meta WhatsApp Cloud API).
# En local: copia este archivo a supabase/functions/.env (no se versiona) y reinicia Supabase.
# En producción: npx supabase secrets set WHATSAPP_TOKEN=... WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_TOKEN=
# Número emisor por defecto: se usa en las sedes que no tienen su propio id en Administración → Sedes.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=lentes_listos
WHATSAPP_TEMPLATE_LANG=es

# Recordatorios de control visual (plantilla de MARKETING, aparte de lentes_listos)
WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_control
# Secreto compartido con la tarea programada (guárdalo también en Vault como "recordatorios_secreto")
RECORDATORIOS_CRON_SECRET=
# Webhook de Meta: App Secret (firma) y el token de verificación que escribes en Meta
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
